{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.23.2"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc -p tsconfig.build.json",
    "lint": "oxlint src test",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "test:live": "node --import tsx test/live-usda.ts",
    "test:db": "node --import tsx --test test/catalog.database.ts"
  },
  "dependencies": {
    "@projeto/database": "workspace:*",
    "fastify": "^5.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.2"
  }
}
