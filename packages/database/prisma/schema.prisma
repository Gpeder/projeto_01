generator client {
  provider = "prisma-client"
  output = "../src/generated/prisma"
  moduleFormat = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

model CatalogFood {
  id                String   @id @default(uuid()) @db.Uuid
  name              String   @db.VarChar(1000)
  brand             String?  @db.VarChar(300)
  preparation       String?  @db.VarChar(300)
  amount            Decimal  @db.Decimal(65, 30)
  unit              String   @db.VarChar(10)
  kcal              Decimal? @db.Decimal(65, 30)
  protein           Decimal? @db.Decimal(65, 30)
  carbs             Decimal? @db.Decimal(65, 30)
  fat               Decimal? @db.Decimal(65, 30)
  source            String   @db.VarChar(6)
  fdcId             BigInt?
  original          Json?
  manuallyEdited    Boolean  @default(false)
  modifiedFields    String[] @default([])
  referenceReviewed Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @db.Timestamptz(3)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
}
